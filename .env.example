# GEMINI_API_KEY: Required for Gemini AI API calls.
# Automatically injected at runtime from confidential environment configuration.
# Configure this via the secure environment panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Automatically injected at runtime with the service deployment URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
